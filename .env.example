# Hash da senha de acesso (gere com: npm run hash-password -- 12345)
APP_PASSWORD_HASH=
# Segredo longo e aleatório para assinar a sessão (ex.: openssl rand -hex 32)
SESSION_SECRET=
# Supabase (Project Settings > API). A chave service_role fica só no servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
