# Hash da senha de acesso (gere com: npm run hash-password -- 12345)
APP_PASSWORD_HASH=
# Segredo longo e aleatório para assinar a sessão (ex.: openssl rand -hex 32)
SESSION_SECRET=
# Supabase. Use a chave publicável + SUPABASE_APP_SECRET (o mesmo valor gravado em
# private.app_secret, ver supabase/migrations/0002) ou, como alternativa, a chave service_role.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_APP_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
